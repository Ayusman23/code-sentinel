# ==============================================================================
# CodeSentinel Master Environment Blueprint
# Multi-Service Architecture for Local, Render & Vercel Deployments
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ingestion Gateway (Control Plane - Node.js Express on Render)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
CLIENT_URL=https://codesentinel.vercel.app

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://admin:your_password@cluster0.mongodb.net/codesentinel?retryWrites=true&w=majority

# Python AI Engine Worker URL
AI_ENGINE_URL=https://codesentinel-ai-engine.onrender.com
AI_ENGINE_TIMEOUT_MS=4000

# GitHub Integration
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_key_codesentinel
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Enterprise Security
JWT_SECRET=super_secret_codesentinel_jwt_key_32_chars_min
API_KEY=cs_live_devsecops_key_enterprise_2026

# Google OAuth 2.0 Credentials (Optional SSO)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://codesentinel-backend.onrender.com/api/auth/google/callback

# Gmail SMTP Critical Alerts (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_gmail_app_password
ALERT_RECIPIENT_EMAIL=security-team@yourdomain.com

# ------------------------------------------------------------------------------
# 2. AI Worker Engine (Worker Plane - Python FastAPI on Render)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
SECRET_ENTROPY_THRESHOLD=3.8
ENABLE_FALLBACK_HEURISTICS=true

# ------------------------------------------------------------------------------
# 3. Enterprise Dashboard (React + Vite on Vercel)
# ------------------------------------------------------------------------------
VITE_BACKEND_URL=https://codesentinel-backend.onrender.com
