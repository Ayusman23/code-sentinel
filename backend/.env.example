# ==============================================================================
# CodeSentinel Ingestion Gateway (Control Plane) Configuration
# Production Environment Blueprint for Render & Vercel
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=production

# Frontend Vercel Origin (Allow CORS from your deployed Vercel domain)
# Example: https://codesentinel.vercel.app or http://localhost:5173
CLIENT_URL=https://codesentinel.vercel.app

# MongoDB Atlas Persistence URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/codesentinel?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:your_secure_password@cluster0.mongodb.net/codesentinel?retryWrites=true&w=majority

# Python AI Engine Worker URL (Deployed on Render)
# Example: https://codesentinel-ai-engine.onrender.com or http://localhost:8000
AI_ENGINE_URL=https://codesentinel-ai-engine.onrender.com
AI_ENGINE_TIMEOUT_MS=4000

# GitHub Webhook Secret & Token
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_key_codesentinel
GITHUB_TOKEN=ghp_your_github_personal_access_token_or_app_token

# Enterprise RBAC & JWT Security
JWT_SECRET=super_secret_codesentinel_jwt_key_32_chars_min
API_KEY=cs_live_devsecops_key_enterprise_2026

# ==============================================================================
# Google Cloud OAuth 2.0 (SSO & Dashboard Authentication)
# ==============================================================================
# In Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth Client ID:
# - Authorized JavaScript Origins: https://codesentinel.vercel.app, http://localhost:5173
# - Authorized Redirect URIs: https://codesentinel-backend.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://codesentinel-backend.onrender.com/api/auth/google/callback

# ==============================================================================
# Gmail / SMTP Critical PR Security Alert Dispatcher (Optional)
# ==============================================================================
# For instant email alerts when a PR has CRITICAL blast radius or exposed secrets:
EMAIL_USER=your_email@gmail.com
# Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_APP_PASSWORD=your_16_digit_gmail_app_password
ALERT_RECIPIENT_EMAIL=security-team@yourdomain.com
