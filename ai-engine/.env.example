# AI Worker Engine Environment Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Secret Scrubber & Heuristics Tuning
SECRET_ENTROPY_THRESHOLD=3.8
MAX_DIFF_LINE_LENGTH=1000
ENABLE_FALLBACK_HEURISTICS=true
